-- =============================================
-- TOP/KALE BULMA
-- =============================================
local function getBall()
    -- Önce workspace içinde "Ball" ara
    local ball = workspace:FindFirstChild("Ball")
    if ball and ball:IsA("BasePart") then return ball end
    
    -- Sonra "ball" ara
    ball = workspace:FindFirstChild("ball")
    if ball and ball:IsA("BasePart") then return ball end
    
    -- Sonra "Top" ara
    ball = workspace:FindFirstChild("Top")
    if ball and ball:IsA("BasePart") then return ball end
    
    -- En son: ismi ball/top içeren herhangi bir BasePart
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local nameLower = obj.Name:lower()
            if nameLower == "ball" or nameLower == "top" or nameLower:find("^ball") or nameLower:find("^top") then
                return obj
            end
        end
    end
    return nil
end

local function getGoal()
    -- workspace içinde "Goal" ara
    local goal = workspace:FindFirstChild("Goal")
    if goal and goal:IsA("BasePart") then return goal end
    
    -- "Kale" ara
    goal = workspace:FindFirstChild("Kale")
    if goal and goal:IsA("BasePart") then return goal end
    
    -- İsmi goal/kale içeren BasePart
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local nameLower = obj.Name:lower()
            if nameLower:find("goal") or nameLower:find("kale") then
                return obj
            end
        end
    end
    return nil
end

-- =============================================
-- BALL HITBOX
-- =============================================
local originalBallSize = nil

local function applyBallHitbox()
    local ball = getBall()
    if not ball then return end
    
    if not originalBallSize then
        originalBallSize = ball.Size
    end
    
    if Settings.BallHitbox then
        pcall(function()
            ball.Size = originalBallSize * Settings.BallSize
            ball.Material = Enum.Material.Neon
            ball.Transparency = 0.2
        end)
    else
        if originalBallSize then
            pcall(function()
                ball.Size = originalBallSize
                ball.Material = Enum.Material.Plastic
                ball.Transparency = 0
            end)
        end
    end
end

-- =============================================
-- REACH
-- =============================================
local function applyReach()
    if not Settings.Reach then return end
    local char = LocalPlayer.Character
    if not char then return end
    local ball = getBall()
    if not ball then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local dist = (ball.Position - hrp.Position).Magnitude
    if dist <= Settings.ReachValue and dist > 5 then
        pcall(function()
            local dir = (hrp.Position - ball.Position).Unit
            ball.AssemblyLinearVelocity = dir * 30
        end)
    end
end

-- =============================================
-- GOAL AIMBOT
-- =============================================
local function applyGoalAimbot()
    if not Settings.GoalAimbot then return end
    local ball = getBall()
    if not ball then return end
    local goal = getGoal()
    if not goal then return end
    
    local currentVel = ball.AssemblyLinearVelocity
    if currentVel.Magnitude > 5 then
        local dir = (goal.Position - ball.Position).Unit
        local targetVel = dir * currentVel.Magnitude
        pcall(function()
            ball.AssemblyLinearVelocity = currentVel:Lerp(targetVel, Settings.GoalAimStrength)
        end)
    end
end

-- =============================================
-- AUTO DIVE
-- =============================================
local function applyAutoDive()
    if not Settings.AutoDive then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local ball = getBall()
    if not ball then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local dist = (ball.Position - hrp.Position).Magnitude
    local ballVel = ball.AssemblyLinearVelocity.Magnitude
    
    if dist < 20 and ballVel > 10 then
        pcall(function()
            if hum.FloorMaterial ~= Enum.Material.Air then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    end
end


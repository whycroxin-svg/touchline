local function createButton(text, callback, yPos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -16, 0, 38)
    btn.Position = UDim2.new(0, 8, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(28, 45, 75)
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(220, 235, 250)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamSemibold
    btn.AutoButtonColor = false
    btn.Active = true
    btn.ZIndex = 105
    btn.Parent = MainFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = Color3.fromRGB(50, 80, 120)
    stroke.Thickness = 1
    
    -- HOVER EFEKTİ
    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = Color3.fromRGB(38, 60, 95)
    end)
    btn.MouseLeave:Connect(function()
        if not btn:GetAttribute("Active") then
            btn.BackgroundColor3 = Color3.fromRGB(28, 45, 75)
        end
    end)
    
    -- MOUSEDOWN KİLİTLİ TIKLAMA
    btn.MouseButton1Down:Connect(function()
        if mouseDown then return end
        mouseDown = true
        callback()
    end)
    
    return btn
end


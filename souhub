-- =============================================
-- UNIVERSAL BALL FINDER (DÜZELTİLDİ)
-- =============================================
local cachedBall = nil
local ballCacheTime = 0

local function isBall(part)
    if not part or not part:IsA("BasePart") then return false end
    local name = part.Name:lower()
    -- Top ismi kontrolü
    if name == "ball" or name == "top" or name == "soccerball" or name == "football" then
        return true
    end
    if name:find("ball") or name:find("top") then
        return true
    end
    -- Shape kontrolü (top yuvarlak olur)
    if part.Shape == Enum.PartType.Ball then
        return true
    end
    -- Mesh kontrolü
    if part:FindFirstChildOfClass("SpecialMesh") then
        local mesh = part:FindFirstChildOfClass("SpecialMesh")
        if mesh.MeshType == Enum.MeshType.Sphere then return true end
    end
    return false
end

local function getBall()
    local now = tick()
    if cachedBall and cachedBall.Parent and (now - ballCacheTime) < 0.5 then
        return cachedBall
    end
    
    -- Önce workspace'te ara
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isBall(obj) then
            cachedBall = obj
            ballCacheTime = now
            return obj
        end
    end
    
    -- Karakterlerin içinde ara
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            for _, obj in ipairs(plr.Character:GetDescendants()) do
                if isBall(obj) then
                    cachedBall = obj
                    ballCacheTime = now
                    return obj
                end
            end
        end
    end
    
    return nil
end

-- =============================================
-- UNIVERSAL GOAL FINDER (DÜZELTİLDİ)
-- =============================================
local cachedGoal = nil
local goalCacheTime = 0

local function getGoal()
    local now = tick()
    if cachedGoal and cachedGoal.Parent and (now - goalCacheTime) < 1 then
        return cachedGoal
    end
    
    local bestGoal = nil
    local bestScore = 0
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            local score = 0
            if name == "goal" then score = 10
            elseif name:find("goal") then score = 8
            elseif name:find("kale") then score = 8
            elseif name:find("net") then score = 5
            elseif name:find("post") then score = 3
            end
            if score > bestScore then
                bestScore = score
                bestGoal = obj
            end
        end
    end
    
    if bestGoal then
        cachedGoal = bestGoal
        goalCacheTime = now
    end
    return bestGoal
end


-- =============================================
-- ESP: HIGHLIGHT (BALL) - BILLBOARD (INFO)
-- =============================================
local ballHighlight = nil
local ballBillboard = nil
local ballHitboxBox = nil
local charHitboxBoxes = {}

local function updateESP()
    local ball = findBall()
    
    -- BALL ESP
    if Settings.BallESP and ball then
        -- Highlight
        if not ballHighlight or ballHighlight.Parent ~= ball then
            if ballHighlight then ballHighlight:Destroy() end
            ballHighlight = Instance.new("Highlight")
            ballHighlight.FillColor = Settings.BallESPColor
            ballHighlight.OutlineColor = Settings.BallESPColor
            ballHighlight.FillTransparency = 0.5
            ballHighlight.OutlineTransparency = 0
            ballHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            ballHighlight.Adornee = ball
            ballHighlight.Parent = ball
        else
            ballHighlight.FillColor = Settings.BallESPColor
            ballHighlight.OutlineColor = Settings.BallESPColor
        end
        
        -- Billboard (Name + Distance)
        if not ballBillboard or ballBillboard.Parent ~= ball then
            if ballBillboard then ballBillboard:Destroy() end
            ballBillboard = Instance.new("BillboardGui")
            ballBillboard.Name = "SOUHUB_BallInfo"
            ballBillboard.Size = UDim2.new(0, 100, 0, 40)
            ballBillboard.StudsOffset = Vector3.new(0, 2.5, 0)
            ballBillboard.AlwaysOnTop = true
            ballBillboard.Adornee = ball
            ballBillboard.Parent = ball
            
            local nameLbl = Instance.new("TextLabel")
            nameLbl.Name = "NameLbl"
            nameLbl.Size = UDim2.new(1, 0, 0, 16)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = "BALL"
            nameLbl.TextColor3 = Settings.BallESPColor
            nameLbl.TextSize = 12
            nameLbl.Font = Enum.Font.GothamBold
            nameLbl.TextStrokeTransparency = 0.3
            nameLbl.Parent = ballBillboard
            
            local distLbl = Instance.new("TextLabel")
            distLbl.Name = "DistLbl"
            distLbl.Size = UDim2.new(1, 0, 0, 14)
            distLbl.Position = UDim2.new(0, 0, 0, 18)
            distLbl.BackgroundTransparency = 1
            distLbl.Text = "0m"
            distLbl.TextColor3 = Settings.BallESPColor
            distLbl.TextSize = 11
            distLbl.Font = Enum.Font.GothamBold
            distLbl.TextStrokeTransparency = 0.3
            distLbl.Parent = ballBillboard
        end
        
        if ballBillboard then
            local nameLbl = ballBillboard:FindFirstChild("NameLbl")
            local distLbl = ballBillboard:FindFirstChild("DistLbl")
            if nameLbl then
                nameLbl.Visible = Settings.BallESPName
                nameLbl.TextColor3 = Settings.BallESPColor
            end
            if distLbl then
                distLbl.Visible = Settings.BallESPDistance
                distLbl.TextColor3 = Settings.BallESPColor
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local dist = (char.HumanoidRootPart.Position - ball.Position).Magnitude
                    distLbl.Text = string.format("%.0fm", dist)
                end
            end
        end
    else
        if ballHighlight then ballHighlight:Destroy() ballHighlight = nil end
        if ballBillboard then ballBillboard:Destroy() ballBillboard = nil end
    end
    
    -- BALL HITBOX ESP
    if Settings.BallHitboxESP and ball then
        if not ballHitboxBox or ballHitboxBox.Parent ~= ball then
            if ballHitboxBox then ballHitboxBox:Destroy() end
            ballHitboxBox = Instance.new("BoxHandleAdornment")
            ballHitboxBox.Name = "SOUHUB_BallHitboxESP"
            ballHitboxBox.Adornee = ball
            ballHitboxBox.Size = ball.Size + Vector3.new(0.3, 0.3, 0.3)
            ballHitboxBox.Color3 = Settings.BallHitboxESPColor
            ballHitboxBox.Transparency = Settings.BallHitboxESPTransparency
            ballHitboxBox.AlwaysOnTop = true
            ballHitboxBox.ZIndex = 5
            ballHitboxBox.Parent = ball
        else
            ballHitboxBox.Size = ball.Size + Vector3.new(0.3, 0.3, 0.3)
            ballHitboxBox.Transparency = Settings.BallHitboxESPTransparency
        end
    else
        if ballHitboxBox then ballHitboxBox:Destroy() ballHitboxBox = nil end
    end
    
    -- HITBOX ESP (KARAKTER)
    if Settings.HitboxESP then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if not charHitboxBoxes[hrp] or not charHitboxBoxes[hrp].Parent then
                        local box = Instance.new("BoxHandleAdornment")
                        box.Name = "SOUHUB_CharBox"
                        box.Adornee = hrp
                        box.Size = hrp.Size
                        box.Color3 = Settings.HitboxESPColor
                        box.Transparency = Settings.HitboxESPTransparency
                        box.AlwaysOnTop = true
                        box.ZIndex = 5
                        box.Parent = hrp
                        charHitboxBoxes[hrp] = box
                    else
                        charHitboxBoxes[hrp].Transparency = Settings.HitboxESPTransparency
                    end
                end
            end
        end
    else
        for part, box in pairs(charHitboxBoxes) do
            if box and box.Parent then box:Destroy() end
        end
        charHitboxBoxes = {}
    end
end

-- =============================================
-- BALL HITBOX (BÜYÜTME - SLIDER İLE)
-- =============================================
local originalBallSize = nil
local originalBallPart = nil

-- =============================================
-- ANA DÖNGÜ
-- =============================================
RunService.RenderStepped:Connect(function()
    updateESP()
    
    local ball = findBall()
    
    -- BALL HITBOX (BÜYÜTME)
    if ball then
        if Settings.BallHitbox then
            if originalBallPart ~= ball then
                originalBallPart = ball
                originalBallSize = ball.Size
            end
            local s = Settings.BallSize
            ball.Size = Vector3.new(s, s, s)
        else
            if originalBallPart and originalBallSize then
                pcall(function() originalBallPart.Size = originalBallSize end)
                originalBallPart = nil
                originalBallSize = nil
            end
        end
        
        -- DEBUG
        DebugLabel.Text = "TOP: " .. ball:GetFullName() .. " | Size: " .. string.format("%.1f", ball.Size.X)
        DebugLabel.TextColor3 = Color3.fromRGB(80, 255, 130)
    else
        DebugLabel.Text = "TOP BULUNAMADI!"
        DebugLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
    end
    
    -- FULLBRIGHT
    if Settings.Fullbright then
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        Lighting.Brightness = 2
    else
        Lighting.Ambient = OriginalLighting.Ambient
        Lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient
        Lighting.Brightness = OriginalLighting.Brightness
    end
    
    -- GOAL AIMBOT
    if Settings.GoalAimbot and ball then
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp and (hrp.Position - ball.Position).Magnitude < 30 then
                local goal = findGoal()
                if goal then
                    local targetCF = CFrame.new(ball.Position, goal.Position)
                    ball.CFrame = ball.CFrame:Lerp(targetCF, Settings.GoalAimStrength * 0.1)
                end
            end
        end
    end
    
    -- AUTO DIVE
    if Settings.AutoDive and ball then
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp and (hrp.Position - ball.Position).Magnitude < 25 then
                local goal = findGoal()
                if goal then
                    local dir = (goal.Position - hrp.Position).Unit
                    hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + dir)
                end
            end
        end
    end
end)


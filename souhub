-- =============================================
-- ESP SİSTEMİ (SelectionBox kullanıyoruz - Highlight yerine)
-- =============================================
local ballSelectionBox = nil
local ballHitboxBox = nil
local charHitboxBoxes = {}

local function updateESP()
    local ball = findBall()
    
    -- Ball ESP (SelectionBox)
    if State.BallESP and ball then
        if not ballSelectionBox or ballSelectionBox.Parent ~= ball then
            if ballSelectionBox then ballSelectionBox:Destroy() end
            ballSelectionBox = Instance.new("SelectionBox")
            ballSelectionBox.Name = "SOUHUB_BallESP"
            ballSelectionBox.Adornee = ball
            ballSelectionBox.Color3 = State.BallESPColor
            ballSelectionBox.LineThickness = 0.15
            ballSelectionBox.SurfaceTransparency = 1
            ballSelectionBox.Transparency = 0
            ballSelectionBox.Parent = ball -- BasePart'a parent'la
        end
    else
        if ballSelectionBox then ballSelectionBox:Destroy() ballSelectionBox = nil end
    end
    
    -- Ball Hitbox ESP (BoxHandleAdornment)
    if State.BallHitboxESP and ball then
        if not ballHitboxBox or ballHitboxBox.Parent ~= ball then
            if ballHitboxBox then ballHitboxBox:Destroy() end
            ballHitboxBox = Instance.new("BoxHandleAdornment")
            ballHitboxBox.Name = "SOUHUB_BallHitboxESP"
            ballHitboxBox.Adornee = ball
            ballHitboxBox.Size = ball.Size + Vector3.new(0.3, 0.3, 0.3)
            ballHitboxBox.Color3 = State.BallHitboxESPColor
            ballHitboxBox.Transparency = 0.4
            ballHitboxBox.AlwaysOnTop = true
            ballHitboxBox.ZIndex = 5
            ballHitboxBox.Parent = ball
        else
            ballHitboxBox.Size = ball.Size + Vector3.new(0.3, 0.3, 0.3)
            ballHitboxBox.Color3 = State.BallHitboxESPColor
        end
    else
        if ballHitboxBox then ballHitboxBox:Destroy() ballHitboxBox = nil end
    end
    
    -- Hitbox ESP (Karakter)
    if State.HitboxESP then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if not charHitboxBoxes[hrp] or not charHitboxBoxes[hrp].Parent then
                        local box = Instance.new("BoxHandleAdornment")
                        box.Name = "SOUHUB_CharBox"
                        box.Adornee = hrp
                        box.Size = hrp.Size
                        box.Color3 = State.HitboxESPColor
                        box.Transparency = 0.5
                        box.AlwaysOnTop = true
                        box.ZIndex = 5
                        box.Parent = hrp
                        charHitboxBoxes[hrp] = box
                    end
                end
            end
        end
    else
        for part, box in pairs(charHitboxBoxes) do
            if box and box.Parent then box:Destroy() end
        end
        charHitboxBoxes = {}
    end
end

-- =============================================
-- BALL HITBOX (Büyütme)
-- =============================================
local originalBallSize = nil
local originalBallPart = nil

-- =============================================
-- ANA DÖNGÜ
-- =============================================
RunService.RenderStepped:Connect(function()
    updateESP()
    
    local ball = findBall()
    
    -- Ball Hitbox (büyütme)
    if ball then
        if State.BallHitbox then
            if originalBallPart ~= ball then
                originalBallPart = ball
                originalBallSize = ball.Size
            end
            local s = State.BallSize
            ball.Size = Vector3.new(s, s, s)
        else
            if originalBallPart and originalBallSize then
                pcall(function() originalBallPart.Size = originalBallSize end)
                originalBallPart = nil
                originalBallSize = nil
            end
        end
    end
    
    -- Fullbright
    if State.Fullbright then
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        Lighting.Brightness = 2
    end
    
    -- Goal Aimbot
    if State.GoalAimbot and ball then
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp and (hrp.Position - ball.Position).Magnitude < 30 then
                local goal = findGoal()
                if goal then
                    local targetCF = CFrame.new(ball.Position, goal.Position)
                    ball.CFrame = ball.CFrame:Lerp(targetCF, State.GoalAimStrength * 0.1)
                end
            end
        end
    end
    
    -- Auto Dive
    if State.AutoDive and ball then
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp and (hrp.Position - ball.Position).Magnitude < 25 then
                local goal = findGoal()
                if goal then
                    local dir = (goal.Position - hrp.Position).Unit
                    hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + dir)
                end
            end
        end
    end
end)


-- BUTON OLUŞTURMA (4 FARKLI TIKLAMA YÖNTEMİ)
-- =============================================
local buttonList = {}

local function createButton(text, callback, yPos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.Position = UDim2.new(0, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(40, 70, 110)
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamSemibold
    btn.AutoButtonColor = true
    btn.Active = true
    btn.Selectable = true
    btn.ZIndex = 102
    btn.Parent = ButtonContainer
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
    
    local clicked = false
    local function onClick()
        if clicked then return end
        clicked = true
        callback()
        task.wait(0.15)
        clicked = false
    end
    
    -- 4 FARKLI YÖNTEM (hangisi çalışırsa)
    btn.MouseButton1Click:Connect(onClick)
    btn.Activated:Connect(onClick)  -- EN GÜVENİLİR
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            onClick()
        end
    end)
    
    table.insert(buttonList, btn)
    return btn
end


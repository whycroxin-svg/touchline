local function updateSize(px)
    local ax, as = sizeBg.AbsolutePosition.X, sizeBg.AbsoluteSize.X
    if as == 0 then return end
    local p = math.clamp((px - ax) / as, 0, 1)
    local val = 1.0 + (10.0 - 1.0) * p
    Settings.BallSize = val
    sizeFill.Size = UDim2.new(p, 0, 1, 0)
    sizeLabel.Text = "Ball Size: " .. string.format("%.1f", val)
end
sizeBg.MouseButton1Down:Connect(function(x) sizeSliding = true; updateSize(x) end)
UserInputService.InputChanged:Connect(function(input)
    if sizeSliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateSize(input.Position.X)
    end
end)

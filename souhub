local hitboxESPStorage = {}

local function createHitboxESP(part)
    if hitboxESPStorage[part] and hitboxESPStorage[part].Parent then return end
    
    local box = Instance.new("BoxHandleAdornment")
    box.Name = "SOUHUB_HitboxESP"
    box.Adornee = part
    box.AlwaysOnTop = true
    box.ZIndex = 5
    box.Size = part.Size
    box.Color3 = Settings.HitboxESPColor
    box.Transparency = Settings.HitboxESPTransparency
    box.Parent = part
    
    hitboxESPStorage[part] = box
end


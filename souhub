-- BALL HITBOX ESP
-- =============================================
local ballHitboxBox = nil
local ballHitboxAdornee = nil

local function updateBallHitboxESP()
    local ball = getBall()
    if not ball then
        if ballHitboxBox and ballHitboxBox.Parent then
            ballHitboxBox:Destroy()
            ballHitboxBox = nil
            ballHitboxAdornee = nil
        end
        return
    end
    
    if ballHitboxBox and ballHitboxBox.Parent and ballHitboxAdornee == ball then
        ballHitboxBox.Size = ball.Size + Vector3.new(0.2, 0.2, 0.2)
        ballHitboxBox.Color3 = Settings.BallHitboxESPColor
        ballHitboxBox.Transparency = Settings.BallHitboxESPTransparency
        return
    end
    
    if ballHitboxBox and ballHitboxBox.Parent then
        ballHitboxBox:Destroy()
    end
    
    local box = Instance.new("BoxHandleAdornment")
    box.Name = "SOUHUB_BallHitboxESP"
    box.Adornee = ball
    box.AlwaysOnTop = true
    box.ZIndex = 5
    box.Size = ball.Size + Vector3.new(0.2, 0.2, 0.2)
    box.Color3 = Settings.BallHitboxESPColor
    box.Transparency = Settings.BallHitboxESPTransparency
    box.Parent = ball
    
    ballHitboxBox = box
    ballHitboxAdornee = ball
end


    -- GUI'yi geri getir
    if MainFrame then MainFrame.Visible = true end
    if Watermark then Watermark.Visible = true end
    
    -- Highlight'ları geri ekle
    for name, parent in pairs(savedHighlightData) do
        if highlightObjects and highlightObjects[name] and parent then
            pcall(function() highlightObjects[name].Parent = parent end)
        end
    end

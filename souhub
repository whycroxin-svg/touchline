-- =============================================
-- TOP BULMA (BASİT VE ETKİLİ)
-- =============================================
local ballCache = nil
local ballCacheTime = 0

local function findBall()
    -- Cache kontrolü (0.5 saniye)
    if ballCache and ballCache.Parent and (tick() - ballCacheTime) < 0.5 then
        return ballCache
    end
    
    -- Shape Ball olanları tara
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Shape == Enum.PartType.Ball then
            if obj.Size.X > 0.5 and obj.Size.X < 10 then
                ballCache = obj
                ballCacheTime = tick()
                return obj
            end
        end
    end
    
    -- İsimde ball/top geçenleri tara
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n == "ball" or n == "top" then
                ballCache = obj
                ballCacheTime = tick()
                return obj
            end
        end
    end
    
    return nil
end


local function createButton(text, callback, yPos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -16, 0, 38)
    btn.Position = UDim2.new(0, 8, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(28, 45, 75)
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Active = true
    btn.ZIndex = 105
    btn.Parent = MainFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = Color3.fromRGB(50, 80, 120)
    stroke.Thickness = 1
    
    -- YEŞİL NOKTA
    local indicator = Instance.new("Frame")
    indicator.Name = "Indicator"
    indicator.Size = UDim2.new(0, 10, 0, 10)
    indicator.Position = UDim2.new(0, 12, 0.5, -5)
    indicator.BackgroundColor3 = Color3.fromRGB(80, 255, 130)
    indicator.BorderSizePixel = 0
    indicator.Visible = false
    indicator.ZIndex = 106
    indicator.Parent = btn
    Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)
    
    local glow = Instance.new("UIStroke", indicator)
    glow.Color = Color3.fromRGB(80, 255, 130)
    glow.Thickness = 3
    glow.Transparency = 0.4
    
    local textLbl = Instance.new("TextLabel")
    textLbl.Name = "TextLbl"
    textLbl.Size = UDim2.new(1, -30, 1, 0)
    textLbl.Position = UDim2.new(0, 28, 0, 0)
    textLbl.BackgroundTransparency = 1
    textLbl.Text = text
    textLbl.TextColor3 = Color3.fromRGB(220, 235, 250)
    textLbl.TextSize = 12
    textLbl.Font = Enum.Font.GothamSemibold
    textLbl.TextXAlignment = Enum.TextXAlignment.Left
    textLbl.ZIndex = 106
    textLbl.Parent = btn
    
    btn.MouseEnter:Connect(function()
        if not btn:GetAttribute("Active") then
            btn.BackgroundColor3 = Color3.fromRGB(38, 60, 95)
        end
    end)
    btn.MouseLeave:Connect(function()
        if not btn:GetAttribute("Active") then
            btn.BackgroundColor3 = Color3.fromRGB(28, 45, 75)
        end
    end)
    
    btn.MouseButton1Down:Connect(function()
        if mouseDown then return end
        mouseDown = true
        callback()
    end)
    
    function btn:SetActive(active)
        self:SetAttribute("Active", active)
        if active then
            self.BackgroundColor3 = Color3.fromRGB(35, 75, 60)
            indicator.Visible = true
            textLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            self.BackgroundColor3 = Color3.fromRGB(28, 45, 75)
            indicator.Visible = false
            textLbl.TextColor3 = Color3.fromRGB(220, 235, 250)
        end
    end
    
    return btn, textLbl
end


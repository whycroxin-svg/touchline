-- =============================================
-- ESP SİSTEMİ (HIGHLIGHT + BOXHANDLEADORNMENT)
-- =============================================
local ballHighlight = nil
local ballHitboxBox = nil

local function updateESP()
    local ball = findBall()
    
    -- Ball ESP (Highlight)
    if Settings.BallESP and ball then
        if not ballHighlight or ballHighlight.Parent ~= ball then
            if ballHighlight then ballHighlight:Destroy() end
            ballHighlight = Instance.new("Highlight")
            ballHighlight.FillColor = Settings.BallESPColor
            ballHighlight.OutlineColor = Settings.BallESPColor
            ballHighlight.FillTransparency = 0.5
            ballHighlight.OutlineTransparency = 0
            ballHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            ballHighlight.Adornee = ball
            ballHighlight.Parent = ball
        end
    else
        if ballHighlight then ballHighlight:Destroy() ballHighlight = nil end
    end
    
    -- Ball Hitbox ESP (BoxHandleAdornment)
    if Settings.BallHitboxESP and ball then
        if not ballHitboxBox or ballHitboxBox.Parent ~= ball then
            if ballHitboxBox then ballHitboxBox:Destroy() end
            ballHitboxBox = Instance.new("BoxHandleAdornment")
            ballHitboxBox.Name = "SOUHUB_HitboxBox"
            ballHitboxBox.Adornee = ball
            ballHitboxBox.Size = ball.Size + Vector3.new(0.3, 0.3, 0.3)
            ballHitboxBox.Color3 = Settings.BallHitboxESPColor
            ballHitboxBox.Transparency = 0.4
            ballHitboxBox.AlwaysOnTop = true
            ballHitboxBox.ZIndex = 5
            ballHitboxBox.Parent = ball
        else
            ballHitboxBox.Size = ball.Size + Vector3.new(0.3, 0.3, 0.3)
            ballHitboxBox.Color3 = Settings.BallHitboxESPColor
        end
    else
        if ballHitboxBox then ballHitboxBox:Destroy() ballHitboxBox = nil end
    end
end

-- =============================================
-- BALL HITBOX (Topu büyüt)
-- =============================================
local originalBallSize = nil
local originalBallPart = nil

-- =============================================
-- ANA DÖNGÜ
-- =============================================
RunService.RenderStepped:Connect(function()
    updateESP()
    
    local ball = findBall()
    
    -- Ball Hitbox (büyütme)
    if ball then
        if Settings.BallHitbox then
            if originalBallPart ~= ball then
                originalBallPart = ball
                originalBallSize = ball.Size
            end
            local s = Settings.BallSize
            ball.Size = Vector3.new(s, s, s)
        else
            if originalBallPart and originalBallSize then
                pcall(function() originalBallPart.Size = originalBallSize end)
                originalBallPart = nil
                originalBallSize = nil
            end
        end
    end
    
    -- Fullbright
    if Settings.Fullbright then
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        Lighting.Brightness = 2
    end
    
    -- Goal Aimbot
    if Settings.GoalAimbot and ball then
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (hrp.Position - ball.Position).Magnitude
                if dist < 30 then
                    -- Kale yönünü bul
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and (obj.Name:lower():find("goal") or obj.Name:lower():find("kale")) then
                            local targetCF = CFrame.new(ball.Position, obj.Position)
                            ball.CFrame = ball.CFrame:Lerp(targetCF, Settings.GoalAimStrength * 0.1)
                            break
                        end
                    end
                end
            end
        end
    end
end)


        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local ball = getBall()
            if hrp and ball then
                local dist = (hrp.Position - ball.Position).Magnitude
                if dist <= Settings.ReachValue then
                    -- Reach aktif
                end
            end
        end
    end
    
    local ball = getBall()
    if ball then
        if Settings.BallHitbox then
            if not originalBallSize then originalBallSize = ball.Size end
            local s = Settings.BallSize

-- =============================================
-- TOP VE KALE BULMA (DOĞRU YÖNTEM)
-- =============================================
local function findBall()
    -- 1. Önce direkt isimle dene
    for _, name in ipairs({"Ball", "ball", "SoccerBall", "soccerball", "Football", "football"}) do
        local b = workspace:FindFirstChild(name)
        if b and b:IsA("BasePart") then return b end
    end
    
    -- 2. GetDescendants ile ara (daha derin)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            -- Shape Ball olan ve boyutu uygun olan
            if obj.Shape == Enum.PartType.Ball then
                if obj.Size.X > 0.5 and obj.Size.X < 10 then
                    return obj
                end
            end
            -- Mesh Sphere olan
            local mesh = obj:FindFirstChildOfClass("SpecialMesh")
            if mesh and mesh.MeshType == Enum.MeshType.Sphere then
                if obj.Size.X > 0.5 and obj.Size.X < 10 then
                    return obj
                end
            end
            -- İsimde ball/top geçen
            if name == "ball" or name == "top" then
                return obj
            end
        end
    end
    
    return nil
end

local function findGoal()
    -- Kale genelde büyük bir model, içinde "Goal" veya "Net" geçen partlar var
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("goal") or name:find("kale") or name:find("net") then
                return obj
            end
        end
    end
    return nil
end

-- =============================================
-- ESP SİSTEMİ (HIGHLIGHT KULLANARAK - DOĞRU YÖNTEM)
-- =============================================
-- Highlight, 3D dünyada çalışır ve BasePart'a parent'lanır [citation:19]
local ballHighlight = nil
local goalHighlight = nil

local function updateESP()
    local ball = findBall()
    
    -- Ball ESP
    if Settings.BallESP and ball then
        if not ballHighlight or ballHighlight.Parent ~= ball then
            if ballHighlight then ballHighlight:Destroy() end
            
            ballHighlight = Instance.new("Highlight")
            ballHighlight.Name = "SOUHUB_BallESP"
            ballHighlight.FillColor = Settings.BallESPColor
            ballHighlight.OutlineColor = Settings.BallESPColor
            ballHighlight.FillTransparency = 0.5
            ballHighlight.OutlineTransparency = 0
            ballHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            ballHighlight.Adornee = ball
            ballHighlight.Parent = ball
        end
        if ballHighlight then
            ballHighlight.FillColor = Settings.BallESPColor
            ballHighlight.OutlineColor = Settings.BallESPColor
        end
    else
        if ballHighlight then ballHighlight:Destroy() ballHighlight = nil end
    end
    
    -- Ball Hitbox ESP (BoxHandleAdornment - doğru parent: ball)
    if Settings.BallHitboxESP and ball then
        if not ball:FindFirstChild("SOUHUB_BallHitboxBox") then
            local box = Instance.new("BoxHandleAdornment")
            box.Name = "SOUHUB_BallHitboxBox"
            box.Adornee = ball
            box.Size = ball.Size + Vector3.new(0.2, 0.2, 0.2)
            box.Color3 = Settings.BallHitboxESPColor
            box.Transparency = 0.5
            box.AlwaysOnTop = true
            box.Shading = Enum.AdornShading.XRayShaded -- Duvarların içinden görünür [citation:22]
            box.Parent = ball -- DOĞRU: Ball'a parent'la
        else
            local box = ball:FindFirstChild("SOUHUB_BallHitboxBox")
            if box then
                box.Size = ball.Size + Vector3.new(0.2, 0.2, 0.2)
                box.Color3 = Settings.BallHitboxESPColor
            end
        end
    else
        if ball then
            local box = ball:FindFirstChild("SOUHUB_BallHitboxBox")
            if box then box:Destroy() end
        end
    end
end


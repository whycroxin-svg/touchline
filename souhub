local sliding = false
local function updateSize(px)
    local ax, as = sizeSliderBg.AbsolutePosition.X, sizeSliderBg.AbsoluteSize.X
    if as == 0 then return end
    local p = math.clamp((px - ax) / as, 0, 1)
    local val = 1.0 + (20.0 - 1.0) * p
    Settings.BallSize = val
    sizeFill.Size = UDim2.new(p, 0, 1, 0)
    sizeSliderLabel.Text = "Ball Size: " .. string.format("%.1f", val)
end
sizeSliderBg.MouseButton1Down:Connect(function(x) sliding = true; updateSize(x) end)
UserInputService.InputChanged:Connect(function(input)
    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateSize(input.Position.X)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
end)


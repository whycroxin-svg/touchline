local function makeToggle(btn, stateVar)
    local isOn = Settings[stateVar] or false
    if isOn then
        btn.BackgroundColor3 = Color3.fromRGB(40, 110, 80)
        btn:SetAttribute("Active", true)
    else
        btn.BackgroundColor3 = Color3.fromRGB(28, 45, 75)
        btn:SetAttribute("Active", false)
    end
end


local function updateSize(px)
    local ax, as = sizeBg.AbsolutePosition.X, sizeBg.AbsoluteSize.X
    if as == 0 then return end
    local p = math.clamp((px - ax) / as, 0, 1)
    local val = 1.0 + (20.0 - 1.0) * p
    Settings.BallSize = val
    sizeFill.Size = UDim2.new(p, 0, 1, 0)
    sizeLabel.Text = "Ball Size: " .. string.format("%.1f", val)
end

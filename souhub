        else
            if originalBallSize then
                ball.Size = originalBallSize
                originalBallSize = nil
            end
        end
    end
end)

-- =============================================
-- RENDER LOOP
-- =============================================
RunService.RenderStepped:Connect(function()
    local ball = getBall()
    
    -- Ball ESP
    if Settings.BallESP and ball then
        if not ballESPStorage[ball] then createBallESP(ball) end
        local data = ballESPStorage[ball]
        if data and data.gui.Parent then
            data.box.BorderColor3 = Settings.BallESPColor
            data.nameLbl.TextColor3 = Settings.BallESPColor
            data.distLbl.TextColor3 = Settings.BallESPColor
            data.box.Visible = Settings.BallESPBox
            data.nameLbl.Visible = Settings.BallESPName
            data.distLbl.Visible = Settings.BallESPDistance
            
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local dist = (char.HumanoidRootPart.Position - ball.Position).Magnitude
                data.distLbl.Text = string.format("%.0fm", dist)
            end
        end
    else
        for b, data in pairs(ballESPStorage) do
            pcall(function() data.gui:Destroy() end)
        end
        ballESPStorage = {}
    end
    
    -- Ball Hitbox ESP
    if Settings.BallHitboxESP then
        updateBallHitboxESP()
    else
        if ballHitboxBox and ballHitboxBox.Parent then
            ballHitboxBox:Destroy()
            ballHitboxBox = nil
            ballHitboxAdornee = nil
        end
    end
    
    -- Hitbox ESP (Karakterler)
    if Settings.HitboxESP then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    createHitboxESP(hrp)
                    local box = hitboxESPStorage[hrp]
                    if box and box.Parent then
                        box.Size = hrp.Size
                        box.Color3 = Settings.HitboxESPColor
                        box.Transparency = Settings.HitboxESPTransparency
                    end
                end
            end
        end
    else
        for part, box in pairs(hitboxESPStorage) do
            if box and box.Parent then box:Destroy() end
            hitboxESPStorage[part] = nil
        end
    end
end)

-- =============================================
-- GOAL AIMBOT & AUTO DIVE
-- =============================================
RunService.RenderStepped:Connect(function()
    if not Settings.GoalAimbot then return end
    local ball = getBall()
    local goal = getGoal()
    if not ball or not goal then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local dist = (hrp.Position - ball.Position).Magnitude
    if dist < 30 then
        local targetCF = CFrame.new(ball.Position, goal.Position)
        ball.CFrame = ball.CFrame:Lerp(targetCF, Settings.GoalAimStrength * 0.1)
    end
end)

RunService.Heartbeat:Connect(function()
    if not Settings.AutoDive then return end
    local ball = getBall()
    if not ball then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local dist = (hrp.Position - ball.Position).Magnitude
    if dist < 25 then
        local goal = getGoal()
        if goal then
            local dir = (goal.Position - hrp.Position).Unit
            hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + dir)
        end
    end
end)

